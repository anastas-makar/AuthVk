<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth.prefs.xml"/>
        <exclude domain="sharedpref" path="tink_prefs.xml"/>
        <exclude domain="sharedpref" path="personal_crypto.prefs.xml"/>
        <exclude domain="sharedpref" path="personal_crypto_tink_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth.prefs.xml"/>
        <exclude domain="sharedpref" path="tink_prefs.xml"/>
        <exclude domain="sharedpref" path="personal_crypto.prefs.xml"/>
        <exclude domain="sharedpref" path="personal_crypto_tink_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
